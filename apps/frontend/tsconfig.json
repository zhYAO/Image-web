{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["node"],
    "typeRoots": ["./node_modules/@types"],
    "paths": {
      "@/features/platform/client-runtime": ["./src/platform/client-runtime.ts"],
      "@/app/use-media-query": ["./src/platform/use-media-query.ts"],
      "@/lib/public-assets": ["./src/platform/public-assets.ts"],
      "@/*": ["../web/*"],
      "@zimage/domain": ["../../packages/domain/src/index.ts"],
      "react": ["./node_modules/@types/react/index.d.ts"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"],
      "next/link": ["./src/platform/link.tsx"],
      "next/image": ["./src/platform/image.tsx"],
      "next/navigation": ["./src/platform/next-navigation.ts"],
      "next/dynamic": ["./src/platform/dynamic.tsx"],
      "lucide-react": ["./node_modules/lucide-react"],
      "@testing-library/react": ["./node_modules/@testing-library/react"],
      "@sentry/browser": ["./node_modules/@sentry/browser"],
      "zod": ["./node_modules/zod"],
      "zustand": ["./node_modules/zustand"],
      "react-markdown": ["./node_modules/react-markdown"],
      "remark-gfm": ["./node_modules/remark-gfm"],
      "remend": ["./node_modules/remend"],
      "shiki": ["./node_modules/shiki"],
      "shiki/core": ["./node_modules/shiki/dist/core.d.mts"],
      "shiki/engine/javascript": ["./node_modules/shiki/dist/engine-javascript.d.mts"],
      "shiki/langs": ["./node_modules/shiki/dist/langs.d.mts"],
      "shiki/themes/*": ["./node_modules/shiki/dist/themes/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "tests/**/*.tsx", "build/**/*.ts"],
  "exclude": ["dist", ".prerender", "node_modules"]
}
