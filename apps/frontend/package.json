    "@zimage/domain": "workspace:*",
    "lucide-react": "1.31.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remend": "1.3.0",
    "shiki": "4.4.3",
    "zod": "4.4.3",
    "zustand": "5.0.4"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "jsdom": "27.0.0",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vitest": "3.2.6"
  }
