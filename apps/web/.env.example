# 本地开发仅使用 apps/web/.env.local（从本示例复制），不要同时维护 .env。
# CI 仅注入生产构建所需公开变量；应用服务端凭据保存在服务器 /etc/zimage/environment。
# 本地运维可选项：ALIYUN_SSH_HOST / ALIYUN_SSH_PORT / ALIYUN_SSH_USER /
# ALIYUN_SSH_PRIVATE_KEY_PATH / ALIYUN_SSH_PASSWORD / BT_PANEL_URL / BT_PANEL_USERNAME / BT_PANEL_PASSWORD。
# 运维凭据不得注入 Web 构建或复制到发布包。
# Canonical environment template for @zimage/web. Copy this file to
# apps/web/.env.local; Next.js loads environment files from the app directory.
#
# Keep mock mode for deterministic local UI development. Phase 2 authentication
# requires both http mode and the authentication gate to be enabled, after the
# Supabase project has email auth configured and migrations applied.
NEXT_PUBLIC_DATA_MODE=mock
NEXT_PUBLIC_PHASE2_AUTH=false
# 自建生产部署设置为 production；生产构建必须使用上面的 http 模式。
# ZIMAGE_DEPLOYMENT_ENV=production
# 小内存构建设置为 1，并使用 next build --webpack；不要与其他构建并行。
# ZIMAGE_BUILD_CPUS=1
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Optional until Supabase CAPTCHA is enabled. When set, the browser completes
# Turnstile before anonymous sign-in and the server-side auto-bootstrap pauses.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only modern Secret Key (sb_secret_...). Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=replace_in_server_secret_store
SUPABASE_DB_URL=postgresql://replace-in-server-secret-store

# Only trust forwarding headers behind a proxy that removes client-supplied values.
ZIMAGE_TRUST_PROXY=false
AUTH_RATE_LIMIT_PEPPER=replace_with_a_random_server_only_value
# Leave unset until the exact service terms and privacy text have formal approval.
# APPROVED_LEGAL_VERSION=approved-version-id

# Provider credentials and physical model mappings belong only in Supabase Edge
# Function Secrets. See supabase/functions/.env.example and doc/doubao-edge-relay-handoff.md.
# This flag permits only funded requests; default false until Edge is validated.
ZIMAGE_DOUBAO_EDGE_ENABLED=false

# Observability is disabled when no DSN is supplied.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0

# Local Supabase captures auth mail in Inbucket and does not deliver it. Configure
# hosted custom SMTP in the Supabase dashboard and keep SMTP credentials there;
# never place them in this file or in a NEXT_PUBLIC_* variable.

# Pause new commerce submissions while keeping history and exports available.
ZIMAGE_COMMERCE_SUBMIT_ENABLED=true

# Local apparel demo only: also requires explicit NEXT_PUBLIC_DATA_MODE=mock,
# a loopback hostname, and no deployed-environment flags. HTTP mode uses auth/RPC.
ZIMAGE_LOCAL_MOCK_RENDER_ENABLED=false

# Apparel optimization controls; production remains locked off in code.
# A true value cannot enable either optimization in a production build/runtime.
# Encoded source reuse is retired after its failed gate; this legacy flag is
# ignored in every environment. Restoring reuse requires reviewed code and acceptance.
ZIMAGE_APPAREL_SOURCE_REUSE_ENABLED=false
# Browser development/test opt-in: changing it requires a new build.
NEXT_PUBLIC_APPAREL_VISIBLE_LOADING_ENABLED=false

# Exact additional browser origins (comma-separated). Next.js normalizes loopback
# URLs to localhost; include the actual 127.0.0.1 URL when using that address.
# Example for the local preview: http://127.0.0.1:3108
ZIMAGE_ALLOWED_ORIGINS=

# Enable only after credit SQL validation and audited database activation.
ZIMAGE_CREDITS_ENABLED=false

# 阿里云 ECS SSH 连接（仅供本地运维使用，应用不会自动读取或发起连接）。
# 将本节复制到 apps/web/.env 后填写；不要填写在此示例文件中。
# 公网 IP 或域名，不含 http:// 或 https://。
ALIYUN_SSH_HOST=
ALIYUN_SSH_PORT=22
# 服务器登录用户名，例如 root、ubuntu 或 ecs-user，以实际配置为准。
ALIYUN_SSH_USER=
# 认证方式二选一：优先填写本机私钥文件的绝对路径，不要粘贴私钥内容。
ALIYUN_SSH_PRIVATE_KEY_PATH=
# 使用密码登录时填写，并将上面的私钥路径留空；值用单引号包裹。
ALIYUN_SSH_PASSWORD=

# 宝塔面板登录（与 SSH 凭据独立；真实值仅填写在 apps/web/.env）。
BT_PANEL_URL=
BT_PANEL_USERNAME=
BT_PANEL_PASSWORD=

# Sharp server-side apparel fonts are independent, verified local resources.
# See ../../ops/aliyun/FONTS.md. Set BOTH in the running process; never NEXT_PUBLIC_.
# ZIMAGE_SHARED_FONT_DIR=/absolute/resources/<manifest-sha256>/fonts
# ZIMAGE_STATIC_ASSET_SHA256=<64-lowercase-hex-manifest-sha256>

# Independent vision deployment mapping; analysis remains unavailable until pricing is approved.
ZIMAGE_DOUBAO_VISION_MODEL=doubao-seed-2-0-lite-260428

# Whole-package billing remains off until verified cost versions and private worker receipts are ready.
ZIMAGE_COMMERCE_PACKAGES_ENABLED=false

# OpenAI chat: server only. Keep disabled until explicit price and runtime activation.
ZIMAGE_OPENAI_ENABLED=false
# OPENAI_API_KEY is stored only in Supabase Edge Function Secrets.
# Image Worker uses its own Supabase Edge Function OPENAI_API_KEY and ZIMAGE_OPENAI_ENABLED.
