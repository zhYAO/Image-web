# Keep mock mode for deterministic local UI development. Switch to http only
# when the Supabase project has anonymous sign-ins and migrations applied.
NEXT_PUBLIC_DATA_MODE=mock
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Optional until Supabase CAPTCHA is enabled. When set, the browser completes
# Turnstile before anonymous sign-in and the server-side auto-bootstrap pauses.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only modern Secret Key (sb_secret_...). Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=replace_in_server_secret_store
SUPABASE_DB_URL=postgresql://replace-in-server-secret-store

# Provider model IDs are deployment mappings; browser code only uses logical IDs.
ARK_API_KEY=replace_in_server_secret_store
GEMINI_API_KEY=replace_in_server_secret_store
MINIMAX_API_KEY=replace_in_server_secret_store
ZIMAGE_DOUBAO_CHAT_MODEL=doubao-seed-2-0-lite-260215
ZIMAGE_MINIMAX_CHAT_MODEL=replace_with_minimax_model_id
ZIMAGE_GEMINI_IMAGE_MODEL=replace_with_gemini_model_id
ZIMAGE_SEEDREAM_IMAGE_MODEL=doubao-seedream-4-5-251128
ZIMAGE_WORKER_CRON_SECRET=replace_in_server_secret_store

# Observability is disabled when no DSN is supplied.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
