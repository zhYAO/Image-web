# Canonical environment template for @zimage/web. Copy this file to
# apps/web/.env.local; Next.js loads environment files from the app directory.
#
# Keep mock mode for deterministic local UI development. Phase 2 authentication
# requires both http mode and the authentication gate to be enabled, after the
# Supabase project has email auth configured and migrations applied.
NEXT_PUBLIC_DATA_MODE=mock
NEXT_PUBLIC_PHASE2_AUTH=false
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Optional until Supabase CAPTCHA is enabled. When set, the browser completes
# Turnstile before anonymous sign-in and the server-side auto-bootstrap pauses.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only modern Secret Key (sb_secret_...). Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=replace_in_server_secret_store
SUPABASE_DB_URL=postgresql://replace-in-server-secret-store

# Only trust forwarding headers behind a proxy that removes client-supplied values.
ZIMAGE_TRUST_PROXY=false
AUTH_RATE_LIMIT_PEPPER=replace_with_a_random_server_only_value
# Leave unset until the exact service terms and privacy text have formal approval.
# APPROVED_LEGAL_VERSION=approved-version-id

# Provider model IDs are deployment mappings; browser code only uses logical IDs.
ARK_API_KEY=replace_in_server_secret_store
GEMINI_API_KEY=replace_in_server_secret_store
MINIMAX_API_KEY=replace_in_server_secret_store
ZIMAGE_DOUBAO_CHAT_MODEL=doubao-seed-2-0-lite-260215
ZIMAGE_MINIMAX_CHAT_MODEL=MiniMax-M2.7
ZIMAGE_GEMINI_IMAGE_MODEL=replace_with_gemini_model_id
ZIMAGE_SEEDREAM_IMAGE_MODEL=doubao-seedream-4-5-251128
ZIMAGE_WORKER_CRON_SECRET=replace_in_server_secret_store

# Observability is disabled when no DSN is supplied.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0

# Local Supabase captures auth mail in Inbucket and does not deliver it. Configure
# hosted custom SMTP in the Supabase dashboard and keep SMTP credentials there;
# never place them in this file or in a NEXT_PUBLIC_* variable.

# Pause new commerce submissions while keeping history and exports available.
ZIMAGE_COMMERCE_SUBMIT_ENABLED=true

# Exact additional browser origins (comma-separated). Next.js normalizes loopback
# URLs to localhost; include the actual 127.0.0.1 URL when using that address.
# Example for the local preview: http://127.0.0.1:3108
ZIMAGE_ALLOWED_ORIGINS=
