{
  "name": "@zimage/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage --testTimeout=60000",
    "test:acceptance-budget": "node --test scripts/real-acceptance-budget.test.mjs",
    "test:markdown": "vitest run tests/markdown-production-profile.test.tsx tests/safe-markdown.test.tsx",
    "test:ui-boundary": "node --test scripts/ui-dependency-boundary.test.mjs",
    "measure:dist": "node scripts/measure-dist.mjs",
    "setup:langgraph": "node scripts/setup-langgraph.mjs"
  },
  "dependencies": {
    "@langchain/core": "1.2.9",
    "@langchain/langgraph": "1.4.9",
    "@langchain/langgraph-checkpoint-postgres": "1.0.4",
    "@sentry/nextjs": "10.75.2",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "@zimage/domain": "workspace:*",
    "lucide-react": "1.31.0",
    "next": "16.4.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remend": "1.3.0",
    "sharp": "0.35.5",
    "shiki": "4.4.3",
    "zod": "4.4.3",
    "zustand": "5.0.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitest/coverage-v8": "3.2.6",
    "jsdom": "27.0.0",
    "typescript": "6.0.3",
    "vitest": "3.2.6"
  }
}
