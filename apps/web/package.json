    "@lobehub/icons": "5.15.0",
    "@lobehub/ui": "5.30.0",
    "@sentry/nextjs": "10.70.0",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "@zimage/domain": "workspace:*",
    "antd": "6.3.5",
    "antd-style": "4.1.0",
    "lucide-react": "1.31.0",
    "next": "16.3.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sharp": "0.35.3",
    "zod": "4.4.3",
    "zustand": "5.0.4"
