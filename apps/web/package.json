    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitest/coverage-v8": "3.2.6",
    "jsdom": "27.0.0",
    "typescript": "6.0.3",
    "vitest": "3.2.6"
  }
