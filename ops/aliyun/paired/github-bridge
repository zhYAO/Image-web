#!/usr/bin/python3 -I
"""Fixed installed staging-only intake. Exit 3 means bytes match, no acceptance."""
import hashlib
import importlib.util
import json
import os
from pathlib import Path
import re
import stat
import struct
import sys
import tempfile

MAGIC = b'ZIMAGE-CI-STAGE\x01'
MEMBERS = (('pins.json', 65536), ('backend.zip', 100_000_000),
           ('frontend.zip', 100_000_000), ('config.json', 65536))
BASE = Path('/usr/local/libexec/zimage-paired-release')
LOCATION = BASE / 'github-bridge'
POLICY = Path('/etc/zimage/ci-staging-bridge.json')
TOOLS = ('github-rehearsal-intake.py', 'release-transport.py', 'three-layer-release.py',
         'release-layers.py', 'release-public-policy.json', 'public-image-contract.py',
         'frontend/manifest.py')
SHA = re.compile('[0-9a-f]{64}')


def root_bytes(path, limit):
    for parent in path.parents:
        info = parent.lstat()
        if info.st_uid != 0 or not stat.S_ISDIR(info.st_mode) or info.st_mode & 0o022:
            raise ValueError('Untrusted installed ancestor')
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, 'rb') as file:
        info = os.fstat(file.fileno())
        if (info.st_uid != 0 or not stat.S_ISREG(info.st_mode) or info.st_nlink != 1
                or info.st_mode & 0o022 or not 0 < info.st_size <= limit):
            raise ValueError('Untrusted installed file')
        body = file.read(limit + 1)
        after = os.fstat(file.fileno())
        if len(body) != info.st_size or (info.st_size, info.st_mtime_ns, info.st_ctime_ns) != (
                after.st_size, after.st_mtime_ns, after.st_ctime_ns):
            raise ValueError('Installed file changed')
        return body


def read_exact(stream, size):
    data = stream.read(size)
    if len(data) != size:
        raise ValueError('Truncated bridge request')
    return data


def receive(stream, destination):
    if read_exact(stream, len(MAGIC)) != MAGIC:
        raise ValueError('Exact staging protocol version required')
    for name, maximum in MEMBERS:
        remaining = struct.unpack('!Q', read_exact(stream, 8))[0]
        if not 0 < remaining <= maximum:
            raise ValueError('Out-of-bound staging member')
        with (destination / name).open('xb') as out:
            while remaining:
                chunk = read_exact(stream, min(remaining, 1024 * 1024))
                out.write(chunk)
                remaining -= len(chunk)
    if stream.read(1):
        raise ValueError('Unexpected trailing staging bytes')


def route(argv, stream, intake, parent):
    if len(argv) != 2 or argv[0] != 'staging' or not SHA.fullmatch(argv[1]):
        raise ValueError('Only fixed staging intake is supported; no authority to publish')
    with tempfile.TemporaryDirectory(prefix='request-', dir=parent) as name:
        request = Path(name)
        receive(stream, request)
        pins = intake.read_json(request / 'pins.json')
        if type(pins) is not dict or 'lane' in pins:
            raise ValueError('Only legacy release pins may enter protected operations')
        config = intake.read_json(request / 'config.json')
        canonical = (json.dumps(pins, sort_keys=True, separators=(',', ':'), allow_nan=False) + '\n').encode()
        if hashlib.sha256(canonical).hexdigest() != argv[1]:
            raise ValueError('Pair digest changed')
        if config.get('formalAuth') is not True or config.get('dataMode') != 'http':
            raise ValueError('Exact authenticated staging public contract required')
        if pins.get('frontendNamespace') != 'release-' + pins['commit'][:12]:
            raise ValueError('Diagnostic namespace cannot enter staging')
        report = intake.evaluate(pins, request / 'backend.zip', request / 'frontend.zip', config)
        if report['immutablePairVerified'] is not True or report['productionReady'] is not False:
            raise ValueError('Immutable pair intake failed')
        return {'schemaVersion': 1, 'kind': 'zimage-staging-intake-only-v1', 'status': 'blocked',
                'pairSha256': argv[1], 'immutablePairVerified': True,
                'authenticatedStaging': False, 'productionReady': False}


def main():
    # Intentionally not a sudo entry point. Root owns installation/policy, not
    # execution; runner cannot select another program, target or authority.
    if (len(sys.argv) != 3 or sys.argv[1] != 'staging' or not SHA.fullmatch(sys.argv[2])
            or Path(__file__).absolute() != LOCATION or not sys.flags.isolated or os.geteuid() == 0):
        raise ValueError('Fixed non-root staging bridge required')
    sys.dont_write_bytecode = True
    root_bytes(LOCATION, 65536)
    policy = json.loads(root_bytes(POLICY, 65536))
    if (set(policy) != {'schemaVersion', 'mode', 'runnerUid', 'tools'} or policy['schemaVersion'] != 1
            or policy['mode'] != 'intake-only' or type(policy['runnerUid']) is not int
            or not policy['runnerUid'] == os.getuid() == os.geteuid()
            or set(policy['tools']) != set(TOOLS)):
        raise ValueError('Missing exact independent staging installation policy')
    os.umask(0o077)
    with tempfile.TemporaryDirectory(prefix='zimage-ci-bridge-', dir='/tmp') as parent:
        workspace = Path(parent)
        # Execute only root-reviewed bytes; never installed bytecode or runner content.
        for name in TOOLS:
            body = root_bytes(BASE / name, 2_097_152)
            if hashlib.sha256(body).hexdigest() != policy['tools'][name]:
                raise ValueError('Staging tool differs from approved digest')
            target = workspace / name
            target.parent.mkdir(exist_ok=True)
            target.write_bytes(body)
        spec = importlib.util.spec_from_file_location('staging_intake', workspace / TOOLS[0])
        intake = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(intake)
        print(json.dumps(route(sys.argv[1:], sys.stdin.buffer, intake, workspace), sort_keys=True))
    return 3


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, ValueError, KeyError, TypeError):
        print('Staging bridge refused or lacks reviewed installation', file=sys.stderr)
        sys.exit(1)
