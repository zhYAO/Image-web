{
  "name": "zimage",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm --filter @zimage/web build",
    "build:frontend": "pnpm --filter @zimage/frontend build",
    "release:frontend": "node scripts/release.mjs frontend deploy",
    "rollback:frontend": "node scripts/release.mjs frontend rollback",
    "release:backend": "node scripts/release.mjs backend deploy",
    "rollback:backend": "node scripts/release.mjs backend rollback",
    "release:status": "node scripts/release.mjs status",
    "test:release-cli": "node --test scripts/release.test.mjs",
    "release:pack": "node ops/aliyun/package-release.mjs",
    "release:pack:full": "node ops/aliyun/package-release.mjs --format full",
    "lint": "eslint apps/web apps/frontend packages/domain --max-warnings=0",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:run": "pnpm -r --if-present test:run",
    "test:dev": "node --test scripts/dev.test.mjs",
    "test:coverage": "pnpm -r --if-present test:coverage",
    "setup:langgraph": "pnpm --filter @zimage/web setup:langgraph"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "3.2.6",
    "eslint": "9.39.2",
    "eslint-config-next": "16.4.1",
    "prettier": "3.9.6",
    "supabase": "2.115.0",
    "typescript": "6.0.3",
    "vitest": "3.2.6"
  }
}
