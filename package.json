{
  "name": "zima",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "11.22.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check:secrets": "secretlint \"**/*\"",
    "db:reset": "supabase db reset",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:types": "node scripts/generate-database-types.mjs",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "mail:start": "docker compose -f compose.mailpit.yaml up -d",
    "mail:stop": "docker compose -f compose.mailpit.yaml down",
    "test": "vitest run",
    "test:db": "supabase test db",
    "test:e2e": "playwright test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.4",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "secretlint": "13.0.4",
    "supabase": "2.114.0",
    "tsx": "4.23.12",
    "turbo": "2.10.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
