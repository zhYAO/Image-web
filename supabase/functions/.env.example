# New Seedream Plan image jobs only. Keep real values in the Supabase
# Edge Function Secrets dashboard, never in this tracked example or browser env.
# The request model is fixed to the Agent Plan alias doubao-seedream-5.0-pro.
ZIMAGE_SEEDREAM_PLAN_API_KEY=
# Retain existing ARK_API_KEY, GEMINI_API_KEY and historical model mappings
# until already queued jobs finish. No fallback or credential sharing with Plan.

# Plan image endpoint is pinned in generation-worker to the official /api/plan/v3/images/generations route.


# Funded Doubao chat, optimization and A+ text/vision relay; disabled by default.
ZIMAGE_DOUBAO_EDGE_ENABLED=false
ZIMAGE_DOUBAO_CHAT_MODEL=replace_with_verified_chat_model
ZIMAGE_DOUBAO_VISION_MODEL=replace_with_verified_vision_model
ZIMAGE_DOUBAO_PLANNER_MODEL=replace_with_verified_planner_model
# ARK_API_KEY is shared only within trusted Edge functions, never returned to Web.
ARK_API_KEY=replace_in_supabase_secrets

# OpenAI chat/images also remain in Edge Secrets only.
ZIMAGE_OPENAI_ENABLED=false
OPENAI_API_KEY=replace_in_supabase_secrets
