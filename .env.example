NEXT_PUBLIC_DATA_MODE=http
NEXT_PUBLIC_PHASE2_AUTH=true
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
SUPABASE_SECRET_KEY=replace-with-server-only-sb_secret-key

# Only trust forwarding headers behind a proxy that removes client-supplied values.
ZIMAGE_TRUST_PROXY=false
AUTH_RATE_LIMIT_PEPPER=replace-with-a-random-server-only-value
# Leave unset until the exact service terms and privacy text have formal approval.
# APPROVED_LEGAL_VERSION=approved-version-id

# Local Supabase captures mail in Inbucket and does not deliver it. Configure hosted SMTP
# through secret management; never place SMTP credentials in this file or NEXT_PUBLIC_*.
